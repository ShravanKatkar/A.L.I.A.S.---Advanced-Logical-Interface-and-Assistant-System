# Core AI & Memory (Required)
# Powers the assistant conversation, proactive context, and automated memory extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative LLM Providers (Optional - switchable in-app without restart)
OPENAI_API_KEY=your_openai_or_github_models_key
DEEPSEEK_API_KEY=your_deepseek_api_key
GROQ_API_KEY=your_groq_api_key
QUBRID_API_KEY=your_qubrid_api_key

# Image Generation Studio (Optional)
POLLINATIONS_API_KEY=your_pollinations_key_here

# Gmail SMTP Email Automation (Optional)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Firebase Authentication Configuration (from Firebase Console -> Project Settings)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
